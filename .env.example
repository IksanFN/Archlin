# Copy to .env, or run `node scripts/generate-env.mjs` to create it with fresh secrets.
# The web and worker processes refuse to start if MIGRATOR_DATABASE_URL is present in their environment.

DATABASE_URL=postgres://cortex_app:dev-only-app@127.0.0.1:54329/cortex

# Base64 of exactly 32 random bytes: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOTP_ENC_KEY=

# One-time code that /setup asks for (at least 32 characters). Leave empty to disable setup once the account exists.
ARCHLIN_SETUP_TOKEN=

# Browser-facing origin without a path or trailing slash; the CSRF check compares against it.
ARCHLIN_PUBLIC_ORIGIN=http://localhost:3000

LOG_LEVEL=info

# Test mode serves /__test/* for end-to-end runs and is refused when NODE_ENV=production.
# ARCHLIN_TEST_MODE=1

# Local compose stack (pnpm stack:up). node scripts/generate-env.mjs fills these with fresh secrets.
POSTGRES_PASSWORD=
CORTEX_MIGRATOR_PASSWORD=
CORTEX_APP_PASSWORD=
CORTEX_BACKUP_PASSWORD=
# Host port of the stack web service, bound to 127.0.0.1.
ARCHLIN_STACK_PORT=8080
# Public key (age1...) that encrypts the nightly backup; the private key never lives on the server.
BACKUP_AGE_RECIPIENT=
BACKUP_TZ=Asia/Jakarta
