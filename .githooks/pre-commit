#!/bin/sh
# Blocks a commit that stages a secret. A local gitleaks is used when installed; otherwise the pinned image runs through Docker.
set -e

if command -v gitleaks >/dev/null 2>&1; then
  exec gitleaks git --pre-commit --staged --redact --verbose --config .gitleaks.toml
fi

if command -v docker >/dev/null 2>&1; then
  # Git Bash would rewrite /repo into a Windows path; safe.directory is needed because the mount belongs to another user.
  export MSYS_NO_PATHCONV=1
  exec docker run --rm -v "$(pwd -W 2>/dev/null || pwd):/repo" -w /repo \
    -e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory -e GIT_CONFIG_VALUE_0=/repo \
    ghcr.io/gitleaks/gitleaks:v8.30.1 git --pre-commit --staged --redact --verbose --config .gitleaks.toml
fi

echo "Neither gitleaks nor Docker was found, so the commit cannot be scanned for secrets. Install one of them." >&2
exit 1
