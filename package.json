{
  "name": "archlin-cortex",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "db:up": "docker compose -f docker/compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker/compose.dev.yml down",
    "test:e2e": "pnpm --filter @archlin/web test:e2e"
  },
  "devDependencies": {
    "@archlin/db": "workspace:*",
    "@archlin/kernel": "workspace:*",
    "@archlin/platform": "workspace:*",
    "@archlin/eslint-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:"
  }
}
